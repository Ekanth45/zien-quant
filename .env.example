# ==============================================================================
# Zien Quant - Order Block Terminal Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the server:
#   cp .env.example .env     (Linux/macOS)
#   Copy-Item .env.example .env (Windows PowerShell)
#
# All variables have production-safe defaults.
# Existing system environment variables will NOT be overwritten by this file.
# ==============================================================================

# Server Network Configuration
HOST=127.0.0.1
PORT=8765
MS_ENV=production

# Database Paths (SQLite WAL Mode)
MS_DB_PATH=work/runtime/marketscope.db
MS_STOCK_DB=work/runtime/stock_master.db
MS_CANDLES_DB=work/runtime/candles.db

# Laya AI Engine (Local Ollama Models)
# Terminal works completely without Ollama (falls back to deterministic rules engine)
# Supported models:
#   - laya-ai   : Specialized quant generative assistant (built from Modelfile via: ollama create laya-ai -f Modelfile)
#   - laya      : Official ModernBERT 421M System 1 decision model (pulled via: ollama pull laya)
#   - gemma4:12b: Base quant foundation model (pulled via: ollama pull gemma4:12b)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:12b
OLLAMA_TIMEOUT=90.0
OLLAMA_KEEP_ALIVE=15m
OLLAMA_CONTEXT_LENGTH=4096
LAYA_ALLOW_RULES_SUMMARY=true

# Test Suite Configuration
# Set to 1 only when running optional end-to-end integration tests with a live Ollama daemon
OLLAMA_INTEGRATION=0

# Broker Integrations (Zerodha Kite Connect) - Not implemented (placeholder for future broker integration)
# Leave empty to use default Yahoo Finance chart candle feed
KITE_API_KEY=
KITE_ACCESS_TOKEN=
